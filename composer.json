{
    "name": "tobento/service-file-storage",
    "version": "2.0.4",
    "type": "library",
    "description": "File storage for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "file",
        "storage"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-collection": "^2.0",
        "tobento/service-iterable": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "league/flysystem": "^3.30"
    },
    "suggest": {
        "tobento/service-repository": "Required to use Repositories",
        "tobento/service-repository-storage": "Required to use Repositories",
        "tobento/service-storage": "Required to use Repositories"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/service-repository": "^2.0",
        "tobento/service-repository-storage": "^2.0",
        "tobento/service-storage": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\FileStorage\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\FileStorage\\Test\\": "tests",
            "App\\": "build/src"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}